    <!-- ══ PANEL: ESCUDO ══ -->
    <div class="panel" id="panel-escudo">
      <div class="section-title" style="margin-top:4px;">[ Datos ]</div>
      <div class="stats-inline">
        <div class="stat-item">
          <div class="stat-symbol">&#9829;</div>
          <div class="stat-name">Vida Bonus</div>
          <div class="stat-val" id="esc-vida">+2</div>
        </div>
        <div class="stat-item">
          <div class="stat-symbol">&#9632;</div>
          <div class="stat-name">Defensa</div>
          <div class="stat-val" id="esc-def">1d4</div>
        </div>
      </div>
      <div class="dur-row">
        <div class="dur-label">&#9670; Duración</div>
        <div class="dur-pips" id="esc-pips"></div>
        <div class="dur-val" id="esc-dur-val">3 combates</div>
      </div>
      <div class="repair-block">&#9830; <span>Reparación:</span> Al romperse se recupera la mitad del material empleado.</div>
    </div>

    <!-- ══ PANEL: ARMADURA ══ -->
    <div class="panel" id="panel-armadura">
      <div class="section-title" style="margin-top:4px;">[ Datos ]</div>
      <div class="stats-inline">
        <div class="stat-item">
          <div class="stat-symbol">&#9829;</div>
          <div class="stat-name">Vida Bonus</div>
          <div class="stat-val" id="arm-vida">+4</div>
        </div>
        <div class="stat-item">
          <div class="stat-symbol">&#9632;</div>
          <div class="stat-name">Defensa</div>
          <div class="stat-val" id="arm-def">1d6</div>
        </div>
      </div>
      <div class="dur-row">
        <div class="dur-label">&#9670; Duración</div>
        <div class="dur-pips" id="arm-pips"></div>
        <div class="dur-val" id="arm-dur-val">4 combates</div>
      </div>
      <div class="repair-block">&#9830; <span>Reparación:</span> Al romperse se recupera la mitad del material empleado.</div>
    </div>

    <!-- ══ PANEL: GENERAL ══ -->
    <div class="panel" id="panel-general">
      <div class="section-title" style="margin-top:4px;">[ Categoría ]</div>
      <div class="cat-chips">
        <div class="cat-chip active" onclick="setCat(this)">&#9652; Material</div>
        <div class="cat-chip" onclick="setCat(this)">&#9830; Accesorio</div>
        <div class="cat-chip" onclick="setCat(this)">&#9678; Utilidad</div>
        <div class="cat-chip" onclick="setCat(this)">&#9824; Consumible</div>
        <div class="cat-chip" onclick="setCat(this)">&#9670; Otro</div>
      </div>
      <div class="field-block" style="margin-top:8px;">
        <div class="field-label"><span class="ico ico-dur"></span> Efecto / Uso</div>
        <div class="field-value" id="f-efecto" contenteditable="true"
             data-placeholder="Describe el efecto o cómo se usa..."
             data-max="200" oninput="onInput(this,'cnt-efecto')" style="min-height:42px"></div>
        <div class="char-counter" id="cnt-efecto">0 / 200</div>
