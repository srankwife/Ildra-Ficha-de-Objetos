        <div class="field-value" id="f-usos" contenteditable="true"
             data-placeholder="Nº de usos, si aplica..."
             data-max="40" oninput="onInput(this,'cnt-usos')"></div>
        <div class="char-counter" id="cnt-usos">0 / 40</div>
