<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Ficha de Objeto — ILDRA</title>
<script src="https://cdn.jsdelivr.net/npm/html-to-image@1.11.11/dist/html-to-image.min.js"></script>
<style>
:root {
  --gold: #d4a843;
  --gold-light: #f0c96a;
  --gold-dim: #8a6830;
  --gold-bright: #ffe080;
  --crimson: #a01c1c;
  --crimson-light: #e03030;
  --darker: #090705;
  --dark: #0f0c08;
  --smoke: #1e1810;
  --card-bg: #0e0b07;
  --text: #e8c870;
  --text-bright: #f5dfa0;
  --text-dim: #9a7e48;
  --border: #3a2a10;
  --border-bright: #5a4020;
  --tier1: #7ec8a0;
  --tier2: #60a8e0;
  --tier3: #c87ae0;
  --font-display: 'Palatino Linotype', 'Book Antiqua', Palatino, 'Times New Roman', serif;
  --font-body: Georgia, 'Times New Roman', serif;
  --font-label: 'Trebuchet MS', Verdana, sans-serif;
}

* { margin:0; padding:0; box-sizing:border-box; }

body {
  background: var(--darker);
  min-height: 100vh;
  font-family: var(--font-body);
  color: var(--text);
  display: flex; flex-direction: column; align-items: center;
  padding: 32px 16px 56px;
  background-image:
    radial-gradient(ellipse at 15% 10%, rgba(160,28,28,0.10) 0%, transparent 45%),
    radial-gradient(ellipse at 85% 85%, rgba(212,168,67,0.07) 0%, transparent 45%);
}

/* ── HEADER ── */
.server-name {
  font-family: var(--font-display);
  font-size: clamp(2rem, 6vw, 2.8rem);
  font-weight: 900;
  color: var(--gold-bright);
  letter-spacing: 0.38em;
  text-align: center;
  margin-bottom: 2px;
  text-shadow: 0 0 24px rgba(255,224,128,0.55), 0 3px 8px rgba(0,0,0,1);
}
.server-subtitle {
  font-family: var(--font-label);
  font-size: 0.62rem; letter-spacing: 0.38em;
  color: var(--gold-dim); text-align: center; text-transform: uppercase;
  margin-bottom: 12px; opacity: 0.9;
}
.page-divider {
  width: 300px; height: 1px;
  background: linear-gradient(to right, transparent, var(--gold), transparent);
  margin: 0 auto 20px; opacity: 0.65;
}

/* ── TABS ── */
.type-tabs { display:flex; gap:3px; margin-bottom:6px; flex-wrap:wrap; justify-content:center; }
.tab {
  padding: 5px 13px;
  font-family: var(--font-label); font-size:0.7rem; letter-spacing:0.1em; font-weight:600;
  cursor:pointer; border:1px solid var(--border); background:var(--smoke);
  color:var(--text-dim); transition:all 0.25s;
  clip-path:polygon(5px 0%,100% 0%,calc(100% - 5px) 100%,0% 100%);
  user-select:none;
}
.tab:hover { color:var(--gold-light); border-color:var(--gold-dim); }
.tab.active { background:linear-gradient(135deg,#2a1e08,#1a1206); color:var(--gold); border-color:var(--gold); text-shadow:0 0 10px rgba(212,168,67,0.7); box-shadow:0 0 10px rgba(212,168,67,0.18); }
.tab[data-type="arma"].active    { border-color:#e07040; color:#f09060; }
.tab[data-type="escudo"].active  { border-color:#60a8e0; color:#90c8f0; }
.tab[data-type="armadura"].active{ border-color:#c87ae0; color:#e0a0f0; }
.tab[data-type="general"].active { border-color:var(--gold); color:var(--gold-bright); }

.tier-tabs { display:flex; gap:3px; margin-bottom:18px; flex-wrap:wrap; justify-content:center; }
.tier-tab {
  padding: 4px 11px;
  font-family: var(--font-label); font-size:0.64rem; letter-spacing:0.1em; font-weight:600;
  cursor:pointer; border:1px solid var(--border); background:var(--smoke);
  color:var(--text-dim); transition:all 0.25s;
  clip-path:polygon(4px 0%,100% 0%,calc(100% - 4px) 100%,0% 100%);
  user-select:none;
}
.tier-tab:hover { color:var(--gold-light); border-color:var(--gold-dim); }
.tier-tab[data-tier="1"].active { border-color:var(--tier1); color:var(--tier1); text-shadow:0 0 8px rgba(126,200,160,0.6); background:rgba(126,200,160,0.07); }
.tier-tab[data-tier="2"].active { border-color:var(--tier2); color:var(--tier2); text-shadow:0 0 8px rgba(96,168,224,0.6); background:rgba(96,168,224,0.07); }
.tier-tab[data-tier="3"].active { border-color:var(--tier3); color:var(--tier3); text-shadow:0 0 8px rgba(200,122,224,0.6); background:rgba(200,122,224,0.07); }

/* ── CARD ── */
.card { width:100%; max-width:500px; position:relative; animation:fadeIn 0.45s ease; }
@keyframes fadeIn { from{opacity:0;transform:translateY(8px)} to{opacity:1;transform:translateY(0)} }
.corner { position:absolute; color:var(--gold-dim); font-size:0.75rem; opacity:0.8; font-family:var(--font-body); }
.corner.tl { top:-3px; left:-1px; }
.corner.tr { top:-3px; right:-1px; }

.card-body {
  background: linear-gradient(160deg,#120f08 0%,#0d0a05 60%,#100d07 100%);
  border:1px solid var(--border-bright); padding:18px 18px 16px;
  box-shadow:0 0 50px rgba(0,0,0,0.9), inset 0 1px 0 rgba(212,168,67,0.12);
}

/* ── SCROLL DECO ── */
.scroll-top { display:flex; align-items:center; gap:10px; margin-bottom:9px; }
.scroll-line { flex:1; height:1px; background:linear-gradient(to right,transparent,var(--gold-dim)); opacity:0.55; }
.scroll-line.rev { background:linear-gradient(to left,transparent,var(--gold-dim)); }
.scroll-sym { font-size:1.1rem; color:var(--gold-light); font-family:var(--font-body); }

/* ── SECTION TITLE ── */
.section-title {
  font-family: var(--font-label); font-size:0.65rem; letter-spacing:0.2em;
  color:var(--gold-light); text-transform:uppercase; font-weight:700;
  margin-bottom:9px; display:flex; align-items:center; justify-content:center; gap:7px;
  text-align:center;
}
.section-title::before { content:''; flex:1; height:1px; background:linear-gradient(to right,transparent,var(--gold-dim)); opacity:0.45; }
.section-title::after  { content:''; flex:1; height:1px; background:linear-gradient(to left,transparent,var(--gold-dim));  opacity:0.45; }

/* ── FIELDS ── */
.field-block { margin-bottom:10px; position:relative; }
.field-label {
  font-family: var(--font-label); font-size:0.6rem; letter-spacing:0.16em;
  color:var(--gold-dim); text-transform:uppercase; margin-bottom:3px; font-weight:600;
  display:flex; align-items:center; gap:6px;
}
.ico { display:inline-block; width:10px; height:10px; border-radius:1px; flex-shrink:0; }
.ico-sword  { background:var(--gold); clip-path:polygon(50% 0%,55% 45%,100% 50%,55% 55%,50% 100%,45% 55%,0% 50%,45% 45%); }
.ico-scroll { background:var(--gold-dim); border-radius:2px; }
.ico-type   { background:#e07040; clip-path:polygon(50% 0%,100% 38%,82% 100%,18% 100%,0% 38%); }
.ico-dur    { background:#f0c030; clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%); }
.ico-owner  { background:var(--gold-light); border-radius:50%; }
.ico-hist   { background:var(--gold-dim); clip-path:polygon(0 0,80% 0,100% 20%,100% 100%,0 100%); }
.ico-spark  { background:var(--gold-light); clip-path:polygon(50% 0%,61% 35%,98% 35%,68% 57%,79% 91%,50% 70%,21% 91%,32% 57%,2% 35%,39% 35%); }

.field-value {
  font-family: var(--font-body); font-size:0.92rem; color:var(--text-bright);
  padding:5px 10px; background:rgba(212,168,67,0.06);
  border-left:2px solid var(--gold-dim); border-bottom:1px solid rgba(212,168,67,0.12);
  min-height:30px; line-height:1.45; transition:all 0.25s;
  overflow-wrap: break-word; word-break: break-word;
}

/* ── NOMBRE centrado ── */
.nombre-block {
  text-align: center;
  margin-bottom: 8px;
}
.nombre-block .field-label {
  justify-content: center;
}
#f-nombre {
  text-align: center;
  font-family: var(--font-display);
  font-size: 1.1rem;
  font-weight: 700;
  letter-spacing: 0.08em;
  border-left: none;
  border-bottom: 1px solid rgba(212,168,67,0.25);
  background: transparent;
  padding: 4px 8px;
}

/* ── PHOTO full width ── */
.photo-wide {
  width: 100%;
  height: 140px;
  border: 1px solid var(--border-bright);
  background: repeating-linear-gradient(45deg,rgba(212,168,67,0.04) 0,rgba(212,168,67,0.04) 1px,transparent 1px,transparent 8px), rgba(0,0,0,0.45);
  display: flex; flex-direction: column; align-items: center; justify-content: center;
  cursor: pointer; position: relative; overflow: hidden; transition: border-color 0.25s;
  margin-bottom: 8px;
}
.photo-wide:hover { border-color: var(--gold-dim); }
.photo-wide img { width:100%; height:100%; object-fit:cover; display:none; }
.photo-placeholder-text {
  text-align:center; color:var(--text-dim); font-size:0.62rem;
  font-style:italic; pointer-events:none; line-height:1.4;
  font-family: var(--font-label);
}
.photo-icon-box {
  width:28px; height:28px; border:1px solid var(--border-bright); margin-bottom:5px;
  display:flex; align-items:center; justify-content:center;
  font-size:1.1rem; opacity:0.5; font-family:var(--font-body); color:var(--gold-dim);
}
#photoInput { display:none; }

/* ── CHAR COUNTER ── */
.char-counter {
  display: none;
  font-family: var(--font-label);
  font-size: 0.52rem;
  letter-spacing: 0.08em;
  color: var(--text-dim);
  text-align: right;
  margin-top: 2px;
  transition: color 0.2s;
}
.char-counter.warn  { color: #f0c030; }
.char-counter.over  { color: var(--crimson-light); }
.char-counter.show  { display: block; }
/* Hide counters when exporting */
.exporting .char-counter { display:none !important; }

/* ── BADGE ROW ── */
.badge-row { display:flex; align-items:center; justify-content:center; gap:8px; flex-wrap:wrap; margin-bottom:8px; }

/* ── TIER BADGE ── */
.tier-badge {
  display:inline-flex; align-items:center; gap:5px; padding:3px 10px;
  font-family:var(--font-label); font-size:0.6rem; letter-spacing:0.18em;
  border:1px solid currentColor; opacity:0.95; font-weight:700; white-space:nowrap;
}
.tier-badge.t0 { color:var(--gold-dim); }
.tier-badge.t1 { color:var(--tier1); border-color:var(--tier1); text-shadow:0 0 8px rgba(126,200,160,0.5); }
.tier-badge.t2 { color:var(--tier2); border-color:var(--tier2); text-shadow:0 0 8px rgba(96,168,224,0.5); }
.tier-badge.t3 { color:var(--tier3); border-color:var(--tier3); text-shadow:0 0 8px rgba(200,122,224,0.5); }

/* ── TYPE BADGE ── */
.type-badge {
  display:inline-flex; align-items:center; gap:5px; padding:3px 10px;
  font-family:var(--font-label); font-size:0.6rem; letter-spacing:0.18em;
  border:1px solid var(--gold-dim); color:var(--gold); opacity:0.95; font-weight:700; white-space:nowrap;
}

/* ── STATS GRID ── */
.stats-inline { display:grid; grid-template-columns:1fr 1fr; gap:8px; margin:8px 0; }
.stat-item { text-align:center; padding:8px 6px; background:rgba(212,168,67,0.06); border:1px solid rgba(212,168,67,0.14); }
.stat-symbol { font-size:0.9rem; font-weight:900; color:var(--gold); margin-bottom:3px; font-family:var(--font-label); }
.stat-name { font-family:var(--font-label); font-size:0.52rem; letter-spacing:0.13em; color:var(--gold-dim); text-transform:uppercase; margin-bottom:4px; font-weight:600; }
.stat-val  { font-family:var(--font-display); font-size:1rem; font-weight:700; color:var(--gold-bright); letter-spacing:0.06em; }
.stat-val.t1 { color: var(--tier1); text-shadow:0 0 8px rgba(126,200,160,0.5); }
.stat-val.t2 { color: var(--tier2); text-shadow:0 0 8px rgba(96,168,224,0.5); }
.stat-val.t3 { color: var(--tier3); text-shadow:0 0 8px rgba(200,122,224,0.5); }

/* ── DURABILITY BAR ── */
.dur-row { display:flex; align-items:center; gap:8px; margin:8px 0; }
.dur-label { font-family:var(--font-label); font-size:0.6rem; letter-spacing:0.12em; color:var(--gold-dim); white-space:nowrap; font-weight:600; min-width:54px; }
.dur-pips { display:flex; gap:4px; flex:1; }
.dur-pip { flex:1; height:10px; border:1px solid var(--border-bright); background:rgba(0,0,0,0.45); transition:background 0.3s, box-shadow 0.3s; }
.dur-pip.filled       { background:var(--gold); box-shadow:0 0 6px rgba(212,168,67,0.6); }
.dur-pip.filled.t0    { background:var(--gold-dim); box-shadow:none; }
.dur-pip.filled.t1    { background:var(--tier1); box-shadow:0 0 6px rgba(126,200,160,0.6); }
.dur-pip.filled.t2    { background:var(--tier2); box-shadow:0 0 6px rgba(96,168,224,0.6); }
.dur-pip.filled.t3    { background:var(--tier3); box-shadow:0 0 6px rgba(200,122,224,0.6); }
.dur-val { font-family:var(--font-label); font-size:0.78rem; font-weight:700; color:var(--gold-light); min-width:52px; text-align:right; white-space:nowrap; }

/* ── REPAIR INFO ── */
.repair-block {
  padding:6px 10px; margin:4px 0 8px;
  background:rgba(212,168,67,0.04); border:1px solid rgba(212,168,67,0.12);
  border-left:2px solid var(--gold-dim);
  font-family:var(--font-label); font-size:0.6rem; letter-spacing:0.08em;
  color:var(--text-dim); line-height:1.6;
}
.repair-block span { color:var(--gold-light); }

/* ── TOGGLE HABILIDAD ── */
.toggle-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:4px; }
.toggle-btn {
  display:flex; align-items:center; gap:5px; cursor:pointer;
  padding:3px 10px; border:1px solid var(--gold-dim);
  background:rgba(212,168,67,0.06); transition:all 0.2s;
  font-family:var(--font-label); font-size:0.6rem; letter-spacing:0.1em; color:var(--gold-dim); font-weight:700;
  user-select:none; white-space:nowrap;
  clip-path:polygon(4px 0%,100% 0%,calc(100% - 4px) 100%,0% 100%);
}
.toggle-btn:hover { border-color:var(--gold); color:var(--gold); }
.toggle-btn.on { border-color:var(--gold-bright); color:var(--gold-bright); background:rgba(212,168,67,0.14); box-shadow:0 0 8px rgba(255,224,128,0.2); }
.toggle-dot { width:7px; height:7px; border-radius:50%; background:var(--gold-dim); transition:background 0.2s, box-shadow 0.2s; flex-shrink:0; }
.toggle-btn.on .toggle-dot { background:var(--gold-bright); box-shadow:0 0 6px rgba(255,224,128,0.9); }
.na-val {
  font-family:var(--font-body); font-size:0.82rem; font-style:italic;
  color:var(--text-dim); padding:5px 10px;
  border-left:2px solid var(--border); border-bottom:1px solid rgba(212,168,67,0.07);
  background:rgba(0,0,0,0.25); text-align:center; letter-spacing:0.1em;
}

/* ── PANEL SECTIONS ── */
.panel { display:none; }
.panel.active { display:block; }

/* ── CAT CHIPS (General) ── */
.cat-chips { display:flex; gap:6px; flex-wrap:wrap; margin-top:6px; justify-content:center; }
.cat-chip {
  padding:3px 10px; font-family:var(--font-label); font-size:0.58rem;
  letter-spacing:0.12em; border:1px solid var(--border-bright); cursor:pointer;
  color:var(--text-dim); background:var(--smoke); transition:all 0.2s;
  clip-path:polygon(4px 0%,100% 0%,calc(100% - 4px) 100%,0% 100%);
  user-select:none;
}
.cat-chip:hover { border-color:var(--gold-dim); color:var(--gold-light); }
.cat-chip.active { border-color:var(--gold); color:var(--gold); background:rgba(212,168,67,0.10); }

/* ── SEP ── */
.sep { height:1px; background:linear-gradient(to right,transparent,var(--border-bright),transparent); margin:10px 0; opacity:0.6; }

/* ── BOTTOM DECO ── */
.bottom-deco { display:flex; align-items:center; gap:8px; margin-top:12px; opacity:0.45; }
.bottom-deco-line { flex:1; height:1px; background:var(--gold-dim); }
.bottom-deco-sym { font-size:0.7rem; color:var(--gold); font-family:var(--font-body); }

/* ── EDITABLE ── */
[contenteditable] { outline:none; cursor:text; }
[contenteditable]:focus { background:rgba(212,168,67,0.09); border-left-color:var(--gold); }
[contenteditable]:empty::before { content:attr(data-placeholder); color:var(--text-dim); font-style:italic; font-size:0.8rem; pointer-events:none; }
#f-nombre:focus { border-bottom-color:var(--gold); }
#f-nombre:empty::before { font-family:var(--font-label); font-size:0.85rem; font-weight:400; }

/* ── SAVE BTN ── */
.save-btn {
  margin-top:18px; display:flex; align-items:center; justify-content:center; gap:8px;
  padding:10px 24px;
  font-family:var(--font-label); font-size:0.72rem; letter-spacing:0.2em; text-transform:uppercase; font-weight:700;
  color:#0a0800; background:linear-gradient(135deg,#f0ca70,#d4a843,#a07828);
  border:none; cursor:pointer;
  clip-path:polygon(9px 0%,100% 0%,calc(100% - 9px) 100%,0% 100%);
  box-shadow:0 0 18px rgba(212,168,67,0.35); transition:all 0.25s;
  width:100%; max-width:500px;
}
.save-btn:hover { box-shadow:0 0 28px rgba(212,168,67,0.55); transform:translateY(-1px); }
.save-btn:active { transform:translateY(1px); }
.save-btn.loading { opacity:0.65; cursor:wait; }
</style>
</head>
<body>

<div class="server-name">𝐈𝐋𝐃𝐑𝐀</div>
<div class="server-subtitle">✦ Ficha de Objeto ✦</div>
<div class="page-divider"></div>

<!-- TYPE SELECTOR -->
<div class="type-tabs">
  <div class="tab active" data-type="arma"     onclick="setType(this)">&#9876; Arma</div>
  <div class="tab"        data-type="escudo"   onclick="setType(this)">&#9632; Escudo</div>
  <div class="tab"        data-type="armadura" onclick="setType(this)">&#9670; Armadura</div>
  <div class="tab"        data-type="general"  onclick="setType(this)">&#9678; General</div>
</div>

<!-- TIER SELECTOR -->
<div class="tier-tabs" id="tierTabsRow">
  <div class="tier-tab"        data-tier="inicial" onclick="setTier(this)">&#9658; Inicial (PJ)</div>
  <div class="tier-tab active" data-tier="1"       onclick="setTier(this)">&#9670; Tier I</div>
  <div class="tier-tab"        data-tier="2"       onclick="setTier(this)">&#9670; Tier II</div>
  <div class="tier-tab"        data-tier="3"       onclick="setTier(this)">&#9670; Tier III</div>
</div>

<!-- ══ CARD ══ -->
<div class="card" id="cardCapture">
  <span class="corner tl">&#10022;</span>
  <span class="corner tr">&#10022;</span>
  <div class="card-body">

    <div class="scroll-top">
      <div class="scroll-line rev"></div>
      <span class="scroll-sym">&#9884;</span>
      <div class="scroll-line"></div>
    </div>

    <div class="section-title">[ Ficha de Objeto ]</div>

    <!-- NOMBRE centrado -->
    <div class="nombre-block field-block">
      <div class="field-label" style="justify-content:center;">
        <span class="ico ico-sword"></span> Nombre
      </div>
      <div class="field-value" id="f-nombre" contenteditable="true"
           data-placeholder="Nombre del objeto..."
           data-max="40" oninput="onInput(this,'cnt-nombre')"></div>
      <div class="char-counter" id="cnt-nombre">0 / 40</div>
    </div>

    <!-- FOTO apaisada, borde a borde -->
    <div class="photo-wide" id="photoWide" onclick="document.getElementById('photoInput').click()">
      <img id="previewImg" src="" alt="">
      <div id="photoPlaceholder">
        <div class="photo-icon-box">[+]</div>
        <div class="photo-placeholder-text">Subir imagen del objeto</div>
      </div>
    </div>
    <input type="file" id="photoInput" accept="image/*" onchange="loadImage(event)">

    <!-- DESCRIPCIÓN bajo la foto -->
    <div class="field-block">
      <div class="field-label"><span class="ico ico-scroll"></span> Descripción</div>
      <div class="field-value" id="f-desc" contenteditable="true"
           data-placeholder="Descripción del objeto..."
           data-max="200" oninput="onInput(this,'cnt-desc')" style="min-height:46px"></div>
      <div class="char-counter" id="cnt-desc">0 / 200</div>
    </div>

    <!-- BADGES centrados -->
    <div class="badge-row">
      <span class="type-badge" id="typeBadge">&#9830; Arma</span>
      <span class="tier-badge t1" id="tierBadge">&#9670; Tier I</span>
    </div>

    <!-- TIPO (oculto en General) -->
    <div class="field-block" id="tipoBlock">
      <div class="field-label"><span class="ico ico-type"></span> Tipo</div>
      <div class="field-value" id="f-tipo" contenteditable="true"
           data-placeholder="Ej: Espada, Hacha, Arco, Daga..."
           data-max="40" oninput="onInput(this,'cnt-tipo')"></div>
      <div class="char-counter" id="cnt-tipo">0 / 40</div>
    </div>

    <!-- ══ PANEL: ARMA ══ -->
    <div class="panel active" id="panel-arma">
      <div class="section-title" style="margin-top:4px;">[ Datos ]</div>
      <div class="stats-inline">
        <div class="stat-item">
          <div class="stat-symbol">&#9876;</div>
          <div class="stat-name">Daño</div>
          <div class="stat-val" id="arma-dano">1d6</div>
        </div>
        <div class="stat-item">
          <div class="stat-symbol">&#9632;</div>
          <div class="stat-name">Defensa</div>
