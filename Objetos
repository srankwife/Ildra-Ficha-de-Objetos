    <div class="sep"></div>

    <!-- ══ HABILIDAD TOGGLE (siempre visible) ══ -->
    <div class="field-block" id="habilidadBlock">
      <div class="toggle-header">
        <div class="field-label" style="margin-bottom:0">
          <span class="ico ico-spark"></span> Habilidad
        </div>
        <div class="toggle-btn" id="habilidadToggle" onclick="toggleHabilidad()">
          <div class="toggle-dot"></div>
          <span id="toggleHabilidadLabel">Activar</span>
        </div>
      </div>
      <div class="na-val" id="habilidadNA">N/A</div>
      <div id="habilidadActive" style="display:none;">
        <div class="field-value" id="f-habilidad" contenteditable="true"
             data-placeholder="Describe la habilidad del objeto..."
             data-max="220" oninput="onInput(this,'cnt-hab')" style="min-height:46px;margin-top:4px;"></div>
        <div class="char-counter" id="cnt-hab">0 / 220</div>
      </div>
    </div>

    <!-- ══ ESTADO ══ -->
    <div class="section-title">[ Estado ]</div>

    <div class="field-block">
      <div class="field-label"><span class="ico ico-hist"></span> Historia</div>
      <div class="field-value" id="f-historia" contenteditable="true"
           data-placeholder="Origen o historia del objeto..."
           data-max="220" oninput="onInput(this,'cnt-hist')" style="min-height:42px"></div>
      <div class="char-counter" id="cnt-hist">0 / 220</div>
    </div>

    <div class="field-block">
      <div class="field-label"><span class="ico ico-owner"></span> Propietario</div>
      <div class="field-value" id="f-propietario" contenteditable="true"
           data-placeholder="Nombre del portador actual..."
           data-max="50" oninput="onInput(this,'cnt-prop')"></div>
      <div class="char-counter" id="cnt-prop">0 / 50</div>
    </div>

    <div class="bottom-deco">
      <div class="bottom-deco-line"></div>
      <span class="bottom-deco-sym">&#10023; &#9830; &#10023;</span>
      <div class="bottom-deco-line"></div>
    </div>

  </div>
</div>

<button class="save-btn" id="saveBtn" onclick="saveAsPNG()">
  &#8659; &nbsp; Guardar Ficha
</button>

<script>
/* ── DATA ── */
const STATS = {
  arma: {
    inicial: { dano:'1d6', def:'1d2', dur:2,  durLabel:'2 combates (inicial)' },
    1:       { dano:'1d6', def:'1d2', dur:3,  durLabel:'3 combates' },
    2:       { dano:'1d8', def:'1d4', dur:4,  durLabel:'4 combates' },
    3:       { dano:'1d10',def:'1d6', dur:6,  durLabel:'6 combates' },
  },
  escudo: {
    inicial: { vida:'+2', def:'1d4', dur:2, durLabel:'2 combates (inicial)' },
    1: { vida:'+2', def:'1d4', dur:3, durLabel:'3 combates' },
    2: { vida:'+4', def:'1d6', dur:4, durLabel:'4 combates' },
    3: { vida:'+6', def:'1d8', dur:6, durLabel:'6 combates' },
  },
  armadura: {
    inicial: { vida:'+4', def:'1d6', dur:2, durLabel:'2 combates (inicial)' },
    1:       { vida:'+4', def:'1d6', dur:4, durLabel:'4 combates' },
    2:       { vida:'+6', def:'1d8', dur:5, durLabel:'5 combates' },
    3:       { vida:'+8', def:'1d10',dur:8, durLabel:'8 combates' },
  }
};

const TYPE_LABELS = { arma:'Arma', escudo:'Escudo', armadura:'Armadura', general:'General' };
const TYPE_SYMS   = { arma:'&#9876;', escudo:'&#9632;', armadura:'&#9670;', general:'&#9678;' };
const TIER_LABELS = { inicial:'Inicial (PJ)', 1:'Tier I', 2:'Tier II', 3:'Tier III' };
const TIER_CLS    = { inicial:'t0', 1:'t1', 2:'t2', 3:'t3' };

let currentType = 'arma';
let currentTier = '1';
let habilidadOn = false;

/* ── CHAR COUNTER ── */
function onInput(el, cntId) {
  const max  = parseInt(el.dataset.max) || 999;
  const len  = el.textContent.length;

  // enforce limit (prevent typing beyond max)
  if (len > max) {
    // trim to max characters
    const sel = window.getSelection();
    const range = sel.getRangeAt(0);
    const offset = range.startOffset;
    el.textContent = el.textContent.substring(0, max);
    // restore cursor
    try {
      const newRange = document.createRange();
      const textNode = el.firstChild;
      if (textNode) {
        newRange.setStart(textNode, Math.min(offset, max));
        newRange.collapse(true);
        sel.removeAllRanges();
        sel.addRange(newRange);
      }
    } catch(e){}
  }

  const actual = el.textContent.length;
  const cnt    = document.getElementById(cntId);
  if (!cnt) return;
  cnt.textContent = actual + ' / ' + max;
  cnt.classList.remove('warn','over');
  if (actual >= max)       cnt.classList.add('over');
  else if (actual >= max * 0.85) cnt.classList.add('warn');
}

function attachFocusCounters() {
  document.querySelectorAll('[data-max]').forEach(el => {
    const cntId = el.dataset.cntId;
    el.addEventListener('focus', () => {
      const cnt = document.getElementById(cntId || el.id.replace('f-','cnt-').replace('f_','cnt-'));
      if (cnt) cnt.classList.add('show');
    });
    el.addEventListener('blur', () => {
      const cnt = document.getElementById(cntId || el.id.replace('f-','cnt-').replace('f_','cnt-'));
      if (cnt) cnt.classList.remove('show');
    });
  });
}

/* ── HABILIDAD TOGGLE ── */
function toggleHabilidad() {
  habilidadOn = !habilidadOn;
  const btn    = document.getElementById('habilidadToggle');
  const lbl    = document.getElementById('toggleHabilidadLabel');
  const na     = document.getElementById('habilidadNA');
  const active = document.getElementById('habilidadActive');

  btn.classList.toggle('on', habilidadOn);
  lbl.textContent    = habilidadOn ? 'Activada' : 'Activar';
  na.style.display   = habilidadOn ? 'none'     : 'block';
  active.style.display = habilidadOn ? 'block'  : 'none';
  if (habilidadOn) document.getElementById('f-habilidad').focus();
}

/* ── TYPE / TIER ── */
function setType(tab) {
  document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
  tab.classList.add('active');
  currentType = tab.dataset.type;

  document.querySelectorAll('.panel').forEach(p => p.classList.remove('active'));
  document.getElementById('panel-' + currentType).classList.add('active');

  document.getElementById('tipoBlock').style.display = (currentType === 'general') ? 'none' : 'block';

  const tierRow = document.getElementById('tierTabsRow');
  if (currentType === 'general') {
    tierRow.style.display = 'none';
  } else {
    tierRow.style.display = 'flex';
  }

  updateBadges();
  updateStats();
}

function setTier(tab) {
  document.querySelectorAll('.tier-tab').forEach(t => t.classList.remove('active'));
  tab.classList.add('active');
  currentTier = tab.dataset.tier;
  updateBadges();
  updateStats();
}

function setCat(chip) {
  document.querySelectorAll('.cat-chip').forEach(c => c.classList.remove('active'));
  chip.classList.add('active');
}

function updateBadges() {
  const typeBadge = document.getElementById('typeBadge');
  typeBadge.innerHTML = TYPE_SYMS[currentType] + ' ' + TYPE_LABELS[currentType];

  const tierBadge = document.getElementById('tierBadge');
  if (currentType === 'general') {
    tierBadge.style.display = 'none';
  } else {
    tierBadge.style.display = 'inline-flex';
    tierBadge.innerHTML = '&#9670; ' + TIER_LABELS[currentTier];
    tierBadge.className = 'tier-badge ' + TIER_CLS[currentTier];
  }
}

function buildPips(containerId, count, tierKey) {
  const el = document.getElementById(containerId);
  if (!el) return;
  el.innerHTML = '';
  const cls = TIER_CLS[tierKey] || '';
  const max = Math.max(count, 8);
  for (let i = 0; i < max; i++) {
    const pip = document.createElement('div');
    pip.className = 'dur-pip' + (i < count ? ' filled ' + cls : '');
    el.appendChild(pip);
  }
}

function updateStats() {
  const type = currentType;
  const tier = currentTier;

  if (type === 'arma') {
    const d = STATS.arma[tier] || STATS.arma[1];
    const cls = TIER_CLS[tier];
    document.getElementById('arma-dano').textContent = d.dano;
    document.getElementById('arma-dano').className = 'stat-val ' + cls;
    document.getElementById('arma-def').textContent  = d.def;
    document.getElementById('arma-def').className    = 'stat-val ' + cls;
    document.getElementById('arma-dur-val').textContent = d.durLabel;
    buildPips('arma-pips', d.dur, tier);

  } else if (type === 'escudo') {
    const d = STATS.escudo[tier] || STATS.escudo[1];
    const cls = TIER_CLS[tier] || TIER_CLS[1];
    document.getElementById('esc-vida').textContent = d.vida;
    document.getElementById('esc-vida').className   = 'stat-val ' + cls;
    document.getElementById('esc-def').textContent  = d.def;
    document.getElementById('esc-def').className    = 'stat-val ' + cls;
    document.getElementById('esc-dur-val').textContent = d.durLabel;
    buildPips('esc-pips', d.dur, tier);

  } else if (type === 'armadura') {
    const d = STATS.armadura[tier] || STATS.armadura[1];
    const cls = TIER_CLS[tier];
    document.getElementById('arm-vida').textContent = d.vida;
    document.getElementById('arm-vida').className   = 'stat-val ' + cls;
    document.getElementById('arm-def').textContent  = d.def;
    document.getElementById('arm-def').className    = 'stat-val ' + cls;
    document.getElementById('arm-dur-val').textContent = d.durLabel;
    buildPips('arm-pips', d.dur, tier);
  }
}

/* ── IMAGE ── */
function loadImage(e) {
  const file = e.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = ev => {
    const img = document.getElementById('previewImg');
    img.src = ev.target.result;
    img.style.display = 'block';
    document.getElementById('photoPlaceholder').style.display = 'none';
  };
  reader.readAsDataURL(file);
}

/* ── SAVE ── */
function saveAsPNG() {
  const btn  = document.getElementById('saveBtn');
  const card = document.getElementById('cardCapture');

  // Hide habilidad block if toggle is OFF
  const habNA     = document.getElementById('habilidadNA');
  const habToggle = document.getElementById('habilidadToggle');
  const habLabel  = document.getElementById('habilidadBlock').querySelector('.field-label');
  let hiddenEls   = [];

  if (!habilidadOn) {
    // hide entire habilidad section from export
    const habBlock = document.getElementById('habilidadBlock');
    habBlock.style.display = 'none';
    hiddenEls.push({ el: habBlock, prop: 'display', val: '' });
  }

  // Add exporting class to hide counters
  card.classList.add('exporting');

  btn.classList.add('loading');
  btn.textContent = 'Generando imagen...';
  card.style.transform = 'translateZ(0)';

  htmlToImage.toJpeg(card, {
    quality: 1, pixelRatio: 3, cacheBust: true,
    backgroundColor: '#0e0b07', skipAutoScale: true
  }).then(function(dataUrl) {
    const nombre = document.getElementById('f-nombre').textContent.trim() || 'objeto';
    const link   = document.createElement('a');
    link.download = `ficha_${nombre.replace(/\s+/g,'_').toLowerCase()}.jpg`;
    link.href = dataUrl;
    link.click();

    // Restore hidden elements
    hiddenEls.forEach(({ el, prop, val }) => el.style[prop] = val);
    card.classList.remove('exporting');
    btn.classList.remove('loading');
    btn.innerHTML = '&#8659; &nbsp; Guardar Ficha';
  }).catch(function(err) {
    console.error(err);
    hiddenEls.forEach(({ el, prop, val }) => el.style[prop] = val);
    card.classList.remove('exporting');
    btn.classList.remove('loading');
    btn.innerHTML = '&#8659; &nbsp; Guardar Ficha';
    alert('Error al generar imagen.');
  });
}

/* ── INIT ── */
updateBadges();
updateStats();
attachFocusCounters();
</script>
</body>
</html>
